{
  "extends": "@hikmahealth/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ESNext", "ES2015"],
    "target": "ES2015",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "declarationMap": true,
    "strict": true,
    "types": ["node"],
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist", "./src/**/*.spec.ts"],
}
