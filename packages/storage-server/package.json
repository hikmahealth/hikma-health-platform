{
  "name": "@hikmahealth/storage-server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "tsc -p ."
  },
  "exports": {
    ".": {
      "default": "./dist/core/index.js",
      "require": "./dist/core/index.js",
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./serve/*": {
      "default": "./dist/serve/*/index.js",
      "types": "./dist/serve/*/index.d.ts",
      "import": "./dist/serve/*/index.d.js",
      "require": "./dist/serve/*/index.js"
    },
    "./options": {
      "default": "./dist/options/index.js",
      "types": "./dist/options/index.d.js",
      "import": "./dist/options/index.d.js",
      "require": "./dist/options/index.js"
    }
  },
  "devDependencies": {
    "@hikmahealth/typescript-config": "workspace:*",
    "@types/node": "22.*",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.14"
  }
}
